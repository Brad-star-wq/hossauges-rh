# ─────────────────────────────────────────────────────────────
# HOSSAUGES — environment template
# Copy this to `.env.local` (which IS gitignored) and fill in real
# values. Never put real secrets in THIS file — it is committed.
# ─────────────────────────────────────────────────────────────

# ── SUPABASE (Session 5) ──
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SECRET — server only, never expose

# ── RESEND (Session 6) ──
# resend.com → API Keys → Create
RESEND_API_KEY=re_your_api_key
# Owner inbox that reserve emails go to (SPEC §6):
OWNER_EMAIL=hossaugessc@outlook.com

# ── ADMIN AUTH (Session 7) — you make these up ──
# Shared password you'll give the Hossauges guys:
ADMIN_PASSWORD=choose-a-shared-password
# Long random string for signing the login cookie.
# Generate with:  openssl rand -base64 32
SESSION_SECRET=

# ── SQUARE (Round 6) — source of truth for all merch ──
# Square Developer dashboard → your app → Production. Use a PERSONAL ACCESS
# TOKEN (not OAuth). Scopes: ITEMS_READ, INVENTORY_READ, ORDERS_WRITE,
# PAYMENTS_WRITE (the last two are for hosted checkout/payment links).
SQUARE_ACCESS_TOKEN=your-square-access-token   # SECRET — server only
SQUARE_LOCATION_ID=your-square-location-id
SQUARE_ENV=production   # or "sandbox"
